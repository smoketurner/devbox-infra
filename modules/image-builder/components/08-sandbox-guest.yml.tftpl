name: SandboxGuest
description: Build the Nitro Sandbox guest root filesystem and, when configured, install the sandbox VMM, jailer and guest kernel
schemaVersion: 1.0
# The guest half of devbox sub-agent sandboxes (smoketurner/devbox#164):
#   - /opt/devbox/sandbox/rootfs.ext4: an Amazon Linux 2023 root (dnf
#     --installroot) with git, tmux, socat, Node and the harness CLIs, the same
#     devbox-agent as the host, and devbox-guest.service (`devbox-agent guest`).
#     Built by scripts/build-sandbox-guest.sh, injected verbatim by components.tf.
#   - Optionally Firecracker, jailer and the guest kernel, downloaded with
#     S3Download from the components bucket (sandbox-artifacts/<name>) and
#     checked against the sha256s in var.sandbox_artifacts. They are not
#     downloaded from anywhere else, because AWS publishes no sandbox-capable
#     build we can point at yet. With none configured, the daemon's preflight
#     reports what is missing.
phases:
  - name: build
    steps:
      - name: BuildGuestRootfs
        action: ExecuteBash
        timeoutSeconds: 3600
        inputs:
          commands:
            - |
              cat > /var/tmp/devbox-guest.service <<'UNIT'
              ${indent(14, trimspace(sandbox_guest_unit))}
              UNIT
            - |
              cat > /var/tmp/build-sandbox-guest.sh <<'SCRIPT'
              ${indent(14, trimspace(sandbox_guest_build_script))}
              SCRIPT
            - >-
              GUEST_PACKAGES="${guest_packages}"
              GUEST_NPM_PACKAGES="${guest_npm_packages}"
              GUEST_UNIT=/var/tmp/devbox-guest.service
              bash /var/tmp/build-sandbox-guest.sh
            - rm -f /var/tmp/build-sandbox-guest.sh /var/tmp/devbox-guest.service
%{ if length(sandbox_artifacts) > 0 ~}
      - name: DownloadSandboxArtifacts
        action: S3Download
        inputs:
%{ for name, sha in sandbox_artifacts ~}
          - source: s3://${components_bucket}/sandbox-artifacts/${name}
            destination: /var/tmp/sandbox-artifacts/${name}
%{ endfor ~}
      - name: InstallSandboxArtifacts
        action: ExecuteBash
        inputs:
          commands:
%{ for name, sha in sandbox_artifacts ~}
            - echo "${sha}  /var/tmp/sandbox-artifacts/${name}" | sha256sum -c -
%{ if name == "vmlinux" ~}
            - install -D -m 0644 /var/tmp/sandbox-artifacts/vmlinux /opt/devbox/sandbox/vmlinux
%{ else ~}
            - install -D -m 0755 /var/tmp/sandbox-artifacts/${name} /usr/local/bin/${name}
%{ endif ~}
%{ endfor ~}
            - rm -rf /var/tmp/sandbox-artifacts
%{ endif ~}
  - name: validate
    steps:
      - name: ValidateSandboxGuest
        action: ExecuteBash
        inputs:
          commands:
            - test -s /opt/devbox/sandbox/rootfs.ext4 || exit 1
            - debugfs -R "stat /usr/local/sbin/devbox-agent" /opt/devbox/sandbox/rootfs.ext4 | grep -q "Type: regular" || exit 1
            - debugfs -R "ls -l /etc/systemd/system/multi-user.target.wants" /opt/devbox/sandbox/rootfs.ext4 | grep -q devbox-guest.service || exit 1
%{ for name, sha in sandbox_artifacts ~}
%{ if name == "vmlinux" ~}
            - test -s /opt/devbox/sandbox/vmlinux || exit 1
%{ else ~}
            - /usr/local/bin/${name} --version || exit 1
%{ endif ~}
%{ endfor ~}
  - name: test
    steps:
      - name: TestSandboxGuest
        action: ExecuteBash
        inputs:
          commands:
            - echo "=== Testing the sandbox guest image on the booted AMI ==="
            - test -s /opt/devbox/sandbox/rootfs.ext4 || exit 1
            - echo "Sandbox guest image present"
