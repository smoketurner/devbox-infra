name: NitroSandboxes
description: Prepare pool hosts launched with enclave options to run Nitro Sandboxes (kernel check, sandbox memory reservation, sandbox daemon)
schemaVersion: 1.0
# Nitro Sandboxes are child VMs created through the Nitro Enclaves driver on the
# parent instance (EC2 user guide: amazon-ec2-nitro-sandboxes,
# nitro-sandboxes-run-firecracker). This component prepares the parent side:
#   - checks the kernel the AMI boots is kernel6.18 at or above the first
#     release with Nitro Sandbox support (01-base upgrades it to the latest);
#   - reserves sandbox memory with the nitro_enclaves.mempool kernel boot
#     argument, as a percentage of RAM so one AMI fits every instance size. The
#     driver is built into kernel6.18 and finds sandbox vCPUs itself, so no
#     allocator service or CPU pool is configured;
#   - devbox-sandboxd.service: the root daemon (`devbox-agent sandboxd`) that
#     jails and runs sandbox VMMs and their vsock relays for the claimant's
#     `devbox-agent sandbox` commands. It is gated on /dev/nitro_enclaves, so
#     hosts launched without enclave options (the default) and the Image
#     Builder instances skip it rather than fail it.
# Firecracker, jailer and the guest kernel and initramfs are baked by
# 08-sandbox-guest.
phases:
  - name: build
    steps:
      - name: CheckKernel
        action: ExecuteBash
        inputs:
          commands:
            - |
              kernel="$(grubby --default-kernel)"
              kver="$${kernel#/boot/vmlinuz-}"
              echo "default kernel: $kver (needs kernel6.18 >= 6.18.51-120.162.amzn2023)"
              rpm -qf "$kernel" --qf '%%{NAME}\n' | grep -qx kernel6.18 || exit 1
              lowest="$(printf '%s\n%s\n' "6.18.51-120.162.amzn2023" "$${kver%.*}" | sort -V | head -n 1)"
              [ "$lowest" = "6.18.51-120.162.amzn2023" ] || exit 1
      - name: ReserveSandboxMemory
        action: ExecuteBash
        inputs:
          commands:
            - grubby --update-kernel=ALL --args="nitro_enclaves.mempool=${sandbox_memory_percent}%"
      - name: InstallSandboxDaemon
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat > /etc/systemd/system/devbox-sandboxd.service <<'EOF'
              ${indent(14, trimspace(sandboxd_unit))}
              EOF
            - systemctl daemon-reload
            - systemctl enable devbox-sandboxd.service
  - name: validate
    steps:
      - name: ValidateNitroSandboxes
        action: ExecuteBash
        inputs:
          commands:
            - grubby --info="$(grubby --default-kernel)" | grep -q "nitro_enclaves.mempool=${sandbox_memory_percent}%" || exit 1
            - systemd-analyze verify /etc/systemd/system/devbox-sandboxd.service || exit 1
            - systemctl is-enabled devbox-sandboxd.service || exit 1
  - name: test
    steps:
      - name: TestNitroSandboxes
        action: ExecuteBash
        inputs:
          commands:
            - echo "=== Testing Nitro Sandbox host prep on the booted AMI ==="
            - grep -q "nitro_enclaves.mempool=${sandbox_memory_percent}%" /proc/cmdline || exit 1
            - systemctl is-enabled devbox-sandboxd.service || exit 1
            # The test instance is launched without enclave options: the daemon
            # must be skipped by its condition, never left failed (a failed unit
            # would mark every non-enclave pool host degraded).
            - |
              if [ -e /dev/nitro_enclaves ]; then
                dmesg | grep -q "nitro_enclaves: CMA pool" || exit 1
                systemctl is-active devbox-sandboxd.service || exit 1
                test -S /run/devbox/sandboxd.sock || exit 1
              elif systemctl is-failed --quiet devbox-sandboxd.service; then
                echo "devbox-sandboxd.service failed on a host without /dev/nitro_enclaves"
                exit 1
              fi
            - echo "Nitro Sandbox host prep verified on boot"
