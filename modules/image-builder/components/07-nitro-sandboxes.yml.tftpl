name: NitroSandboxes
description: Install the Nitro Enclaves driver tooling and a self-sizing allocator so pool hosts launched with enclave options can run Nitro Sandboxes
schemaVersion: 1.0
# Nitro Sandboxes are child VMs created through the Nitro Enclaves driver on the
# parent instance (EC2 user guide: amazon-ec2-nitro-sandboxes). This component
# prepares the parent side only:
#   - aws-nitro-enclaves-cli (allocator service + driver tooling, AL2023 dnf);
#   - a pre-start script that sizes /etc/nitro_enclaves/allocator.yaml from the
#     instance's own vCPU/memory, because the pool instance type is a Terraform
#     variable and the allocator's static 2 vCPU default can't fit a 2-vCPU host;
#   - a drop-in gating the allocator on /dev/nitro_enclaves, so the same AMI boots
#     cleanly on hosts launched without enclave options (the default) and on the
#     Image Builder build/test instances.
#   - devbox-sandboxd.service: the root daemon (`devbox-agent sandboxd`) that
#     jails and runs sandbox VMMs and their vsock relays for the claimant's
#     `devbox-agent sandbox` commands, gated on /dev/nitro_enclaves like the
#     allocator. Needs an agent release with `sandboxd` (ordering gate).
# The script and units are real files, injected verbatim by components.tf so
# they can be linted and diffed on their own: scripts/devbox-nitro-sandbox-size.sh,
# files/nitro-enclaves-allocator-devbox.conf, files/devbox-sandboxd.service.
# The guest VMM (Firecracker with sandbox support), jailer and guest image are
# not baked here yet: AWS documents no package or release for a sandbox-capable
# build.
phases:
  - name: build
    steps:
      - name: InstallNitroEnclavesCli
        action: ExecuteBash
        inputs:
          commands:
            - dnf install -y aws-nitro-enclaves-cli
      - name: InstallAllocatorSizing
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat > /usr/local/sbin/devbox-nitro-sandbox-size <<'EOF'
              ${indent(14, trimspace(nitro_sandbox_size_script))}
              EOF
            - chmod 0755 /usr/local/sbin/devbox-nitro-sandbox-size
            - mkdir -p /etc/systemd/system/nitro-enclaves-allocator.service.d
            - |
              cat > /etc/systemd/system/nitro-enclaves-allocator.service.d/10-devbox.conf <<'EOF'
              ${indent(14, trimspace(nitro_allocator_dropin))}
              EOF
            - systemctl daemon-reload
            - systemctl enable nitro-enclaves-allocator.service
      - name: InstallSandboxDaemon
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat > /etc/systemd/system/devbox-sandboxd.service <<'EOF'
              ${indent(14, trimspace(sandboxd_unit))}
              EOF
            - systemctl daemon-reload
            - systemctl enable devbox-sandboxd.service
  - name: validate
    steps:
      - name: ValidateNitroSandboxes
        action: ExecuteBash
        inputs:
          commands:
            - rpm -q aws-nitro-enclaves-cli || exit 1
            - command -v nitro-cli || exit 1
            - bash -n /usr/local/sbin/devbox-nitro-sandbox-size || exit 1
            - grep -q "ConditionPathExists=/dev/nitro_enclaves" /etc/systemd/system/nitro-enclaves-allocator.service.d/10-devbox.conf || exit 1
            - systemctl is-enabled nitro-enclaves-allocator.service || exit 1
            - systemd-analyze verify /etc/systemd/system/devbox-sandboxd.service || exit 1
            - systemctl is-enabled devbox-sandboxd.service || exit 1
  - name: test
    steps:
      - name: TestNitroSandboxes
        action: ExecuteBash
        inputs:
          commands:
            - echo "=== Testing Nitro Sandbox host prep on the booted AMI ==="
            - command -v nitro-cli || exit 1
            - systemctl is-enabled nitro-enclaves-allocator.service || exit 1
            # The test instance is launched without enclave options: the allocator
            # must be skipped by its condition, never left failed (a failed unit
            # would mark every non-enclave pool host degraded).
            - |
              if [ -e /dev/nitro_enclaves ]; then
                systemctl is-active nitro-enclaves-allocator.service || exit 1
                test -s /etc/nitro_enclaves/allocator.yaml || exit 1
                systemctl is-active devbox-sandboxd.service || exit 1
                test -S /run/devbox/sandboxd.sock || exit 1
              else
                for unit in nitro-enclaves-allocator.service devbox-sandboxd.service; do
                  if systemctl is-failed --quiet "$unit"; then
                    echo "$unit failed on a host without /dev/nitro_enclaves"
                    exit 1
                  fi
                done
              fi
            - echo "Nitro Sandbox host prep verified on boot"
